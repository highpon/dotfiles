# Fonts: JetBrains Mono, with the Japanese CJK font as fallback
# (otherwise kanji fall back to the Korean variant).
font-family = "JetBrains Mono"
font-family = "Noto Sans Mono CJK JP"
font-family-bold = "JetBrains Mono"
font-family-bold = "Noto Sans Mono CJK JP"

# Match Neovim's tokyonight-night colorscheme.
theme = "TokyoNight Night"

# Keep terminfo working under sudo and over ssh.
shell-integration-features = sudo,ssh-env,ssh-terminfo

# Notify when a long command finishes while Ghostty is not focused.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
notify-on-command-finish-action = bell,notify

# macOS: use Option as Alt (zsh/fzf keybindings). Ignored on Linux.
macos-option-as-alt = true
