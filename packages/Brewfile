# macOS packages the dotfiles depend on (installed with brew bundle).
brew "chezmoi"
brew "git"

# sheldon has no Intel Mac binary for mise to install.
brew "sheldon" if Hardware::CPU.intel?

# Use the Homebrew cask, not the App Store build: the SSH agent socket
# is then at ~/.bitwarden-ssh-agent.sock, the same path as on Linux.
cask "bitwarden"
cask "ghostty"
