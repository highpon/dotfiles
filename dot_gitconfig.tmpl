{{- $signingKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
{{- /* The private key lives in Bitwarden and is served by its SSH agent. */ -}}
[user]
	email = s.shiraki.business@gmail.com
	name = HighPon
	signingkey = {{ $signingKey }}
[alias]
	s = status
	co = checkout
	last = log -1 HEAD
	cl = clone
	df = diff
	ds = diff --staged
	dn = diff --name-only
	ps = push origin
	line = log --oneline
	ref = reflog
	main = branch -M main
	gr = log --oneline --graph

# Sign commits and tags with the SSH key from Bitwarden.
# It is registered on GitHub as a "Signing key" for the Verified badge.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
