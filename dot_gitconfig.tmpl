{{- $signingKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
[user]
	email = s.shiraki.business@gmail.com
	name = HighPon
{{- if stat $signingKey }}
	signingkey = {{ $signingKey }}
{{- end }}
[alias]
	s = status
	co = checkout
	last = log -1 HEAD
	cl = clone
	df = diff
	ds = diff --staged
	dn = diff --name-only
	ps = push origin
	line = log --oneline
	ref = reflog
	main = branch -M main
	gr = log --oneline --graph
{{- if stat $signingKey }}

# Sign commits and tags with this machine's SSH key.
# Register it on GitHub as a "Signing key" to get the Verified badge.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
