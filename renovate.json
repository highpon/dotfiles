{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeAll",
    ":prHourlyLimitNone",
    ":dependencyDashboard"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "timezone": "Asia/Tokyo",
  "ignoreTests": true,
  "packageRules": [
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools"
    }
  ]
}
